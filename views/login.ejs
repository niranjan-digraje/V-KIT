<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white flex items-center justify-center min-h-screen">
    <div class="bg-gray-800 p-6 rounded-lg shadow-lg max-w-[400px] w-full">
        <h1 class="text-2xl text-center mb-6 font-semibold">Login Your Account</h1>
        <form action="/login" method="post" class="space-y-5"> 
            <input class="px-3 py-2 bg-white text-black border border-gray-400 rounded-md w-full" type="email" name="email" placeholder="Email" required>
            <input class="px-3 py-2 bg-white text-black border border-gray-400 rounded-md w-full" type="password" name="password" placeholder="Password" required>
            <input class="px-4 py-2 bg-blue-500 rounded-md w-full cursor-pointer font-medium" type="submit" value="Login">
        </form>

        
        <div class="flex justify-center mt-6"> 
            <a class=" text-sm" href="/signup"> Or Signup</a>
        </div>
    </div>


    
</body>
</html>

