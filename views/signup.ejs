<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Signup</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white flex items-center justify-center min-h-screen">
    <div class="bg-gray-800 p-6 rounded-lg shadow-lg max-w-[400px] w-full">
        <div class="flex justify-end">
            <a class="bg-blue-500 rounded-md px-4 py-2 text-sm" href="/login">Login</a>
        </div>
        <h1 class="text-2xl text-center mb-4 font-semibold">Create an Account</h1>
        <form action="/register" method="post" class="space-y-3">
            <input class="px-3 py-2 bg-white text-black border border-gray-400 rounded-md w-full" type="text" name="name" placeholder="Full Name" required>
            <input class="px-3 py-2 bg-white text-black border border-gray-400 rounded-md w-full" type="text" name="username" placeholder="Username" required>
            <input class="px-3 py-2 bg-white text-black border border-gray-400 rounded-md w-full" type="email" name="email" placeholder="Email" required>
            <input class="px-3 py-2 bg-white text-black border border-gray-400 rounded-md w-full" type="password" name="password" placeholder="Password" required>
            <input class="px-4 py-2 bg-blue-500 rounded-md w-full cursor-pointer font-medium" type="submit" value="Signup">
        </form>
    </div>
</body>
</html>
