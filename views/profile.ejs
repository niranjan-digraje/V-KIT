<%- include("sidebar.ejs") %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Profile</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/css/profile.css">
</head>

<body>
  <div class="container profile-container">
    <div class="col-md-8 col-lg-6">
      <h1 class="pl-3 pt-2">Profile</h1>
      <div class="card">
        <div class="row no-gutters">
          <div class="col-md-5 left-section">
            <img src="/images/profile.jpeg" class="profile-img" alt="Profile Image">
          </div>
          <div class="col-md-7 right-section d-flex align-items-center">
            <div class="card-body">
              <h5 class="card-title font-weight-bold"><%= user.username %></h5>
              <p><strong>Name :</strong> <%= user.name %></p>
              <p><strong>Email :</strong> <%= user.email %></p>
              <p><strong>Password :</strong> ••••••••</p>
              <br>
              <a style="float: right; color: brown ;" id="logout" href="/logout"><b>logout</b><i class="fa-solid fa-arrow-right-from-bracket"></i>&nbsp;&nbsp;</a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

</body>
</html>
